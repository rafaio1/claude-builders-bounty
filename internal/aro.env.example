# ARO identity / budgets. Copy to /root/.automaton/aro.env (mode 0600).
# Do not put this file in git with real values. The agent does not invent them.
#
# ARO_OWNER_NAME=
# ARO_BUSINESS_NAME=
# ARO_MINIMUM_PAYOUT=
# ARO_INITIAL_OPERATING_BUDGET=
# ARO_MAX_SINGLE_EXPENSE=
# ARO_MAX_DAILY_EXPENSE=
# ARO_MINIMUM_CASH_RESERVE=
# ARO_PRICE_FLOOR_BRL=250
# ARO_COMMERCIAL_OUTBOUND=0
#
# Payout destination is a separate 0600 file:
#   /root/.automaton/aro-payout.dest
# The agent must not create, replace or edit that file.
