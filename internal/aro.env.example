# ARO identity / budgets. Copy to /root/.automaton/aro.env (mode 0600).
# Do not put this file in git with real values. The agent does not invent them.
#
# ARO_OWNER_NAME=
# ARO_BUSINESS_NAME=
# ARO_MICRO_FLOOR_BRL=10
# ARO_MILESTONE_BRL=1000
# ARO_MILESTONE_OWNER_SHARE=0.50
# ARO_FULL_AUTONOMY=0
# ARO_MAY_CREATE_RECEIVE_WALLET=0
# ARO_P2P_AUTHORIZED=0
# ARO_P2P_LIVE=0
# ARO_P2P_TOKEN=USDT
# ARO_P2P_CURRENCY=BRL
# ARO_MINIMUM_PAYOUT=50
# ARO_INITIAL_OPERATING_BUDGET=50
# ARO_MAX_SINGLE_EXPENSE=50
# ARO_MAX_DAILY_EXPENSE=50
# ARO_MINIMUM_CASH_RESERVE=50
# ARO_PRICE_FLOOR_BRL=250
# ARO_COMMERCIAL_OUTBOUND=0
# ARO_MAY_OPEN_RECEIVE_ACCOUNTS=0
# ARO_PAYOUT_CHANNEL=wise
#
# Wise token (separate 0600 file):
#   /root/.automaton/wise.env
#   WISE_API_TOKEN=...
#
# Optional Bybit hop destination — agent MUST NOT write:
#   /root/.automaton/aro-payout.dest
