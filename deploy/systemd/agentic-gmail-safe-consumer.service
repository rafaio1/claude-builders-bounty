[Unit]
Description=Deterministic safe consumer for Gmail action queue
After=network-online.target agentic-gmail-inbox-ingestor.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/
ExecStart=/usr/local/libexec/agentic-gmail-safe-consumer --max-items 1000 --max-github-network 50
User=root
Group=root
UMask=0077
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/root
Environment=GH_CONFIG_DIR=/root/.config/gh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
TemporaryFileSystem=/Agentic:ro
BindPaths=/Agentic/state:/Agentic/state
BindPaths=/Agentic/data/aro/inbox:/Agentic/data/aro/inbox
RuntimeDirectory=agentic-gmail-consumer
RuntimeDirectoryMode=0700
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TimeoutStartSec=10min
