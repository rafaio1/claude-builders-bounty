[Unit]
Description=Agentic bounded Drips Wave opportunity scanner
Wants=network-online.target
After=network-online.target
ConditionPathExists=/Agentic/tools/drips_wave_scanner.py

[Service]
Type=oneshot
User=root
WorkingDirectory=/Agentic
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /Agentic/tools/drips_wave_scanner.py --pages 5 --top 10
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUQuota=25%
MemoryMax=256M
TasksMax=16
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/Agentic/state
TimeoutStartSec=3min
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
