[Unit]
Description=Agentic Revenue Control Plane v2 (fail-closed)
Documentation=file:/Agentic/state/revenue_v2_ready.json
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=900
StartLimitBurst=5
ConditionFileIsExecutable=/Agentic/.venv/bin/python
ConditionPathIsReadWrite=/Agentic/data/aro
ConditionPathExists=/Agentic/tools/revenue_control_plane.py

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/Agentic
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/Agentic/.venv/bin/python /Agentic/tools/revenue_control_plane.py --db /Agentic/data/aro/revenue_control_plane_v2.db --status-file /Agentic/data/aro/revenue_manager_v2_status.json --lock-file /Agentic/data/aro/.revenue_control_plane_v2.lock loop --interval 900 --max-iterations 96 --max-orders 3 --payout-method stripe
Restart=always
RestartSec=30s
TimeoutStopSec=30s
KillMode=control-group

Nice=15
CPUAccounting=yes
CPUQuota=15%
IOAccounting=yes
IOWeight=10
MemoryAccounting=yes
MemoryMax=256M
TasksMax=32
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
ReadOnlyPaths=/tmp /var/tmp
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/Agentic/data/aro
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

StandardOutput=journal
StandardError=journal
SyslogIdentifier=agentic-revenue-control-plane-v2

[Install]
WantedBy=multi-user.target
