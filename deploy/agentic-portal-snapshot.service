[Unit]
Description=Build the sanitized Agentic portal snapshot
Documentation=file:///Agentic/README.md
After=local-fs.target

[Service]
Type=oneshot
User=root
Group=agentic-portal
WorkingDirectory=/
UMask=0077
StateDirectory=agentic-portal
StateDirectoryMode=0750

Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/Agentic/src

ExecStartPre=/usr/bin/rm -f -- /var/lib/agentic-portal/.state.next.json
ExecStart=/Agentic/.venv/bin/python -m agentic.portal_snapshot --root /Agentic --inbox /var/lib/agentic-portal/inbox.jsonl --output /var/lib/agentic-portal/.state.next.json
ExecStartPost=/usr/bin/chmod 0440 /var/lib/agentic-portal/.state.next.json
ExecStartPost=/usr/bin/mv -f -- /var/lib/agentic-portal/.state.next.json /var/lib/agentic-portal/state.json
TimeoutStartSec=60s
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateMounts=yes
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/Agentic
ReadWritePaths=/var/lib/agentic-portal
InaccessiblePaths=-/Agentic/.env -/root/.automaton -/root/.ssh -/root/.gnupg
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

LimitCORE=0
LimitNOFILE=128
LimitNPROC=32
TasksMax=32
MemoryMax=256M
OOMPolicy=stop

StandardOutput=journal
StandardError=journal
SyslogIdentifier=agentic-portal-snapshot
