[Unit]
Description=Agentic improve mapper (GhostCLI census of bottlenecks every hour)
Documentation=file:///Agentic/improve/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/Agentic
EnvironmentFile=-/root/.automaton/.env
EnvironmentFile=-/Agentic/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/Agentic/src
Environment=AGENTIC_LIVE_TRADE=0
Nice=12
TimeoutStartSec=900
ExecStart=/Agentic/.venv/bin/python -m agentic improve map
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agentic-improve-map

[Install]
WantedBy=multi-user.target
