[Unit]
Description=Agentic local authenticated ARO monitoring portal
Documentation=file:///Agentic/README.md
Wants=agentic-portal-snapshot.service
After=local-fs.target agentic-portal-snapshot.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
User=agentic-portal
Group=agentic-portal
WorkingDirectory=/
UMask=0077

LoadCredential=portal_password_hash:/etc/agentic-portal/credentials/portal_password_hash
LoadCredential=portal_username:/etc/agentic-portal/credentials/portal_username
LoadCredential=portal_display_name:/etc/agentic-portal/credentials/portal_display_name

Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=AGENTIC_PORTAL_HOST=0.0.0.0
Environment=AGENTIC_PORTAL_PORT=8767
Environment=AGENTIC_PORTAL_STATE_PATH=/var/lib/agentic-portal/state.json
Environment=AGENTIC_PORTAL_INBOX_PATH=/var/lib/agentic-portal/inbox.jsonl
Environment=AGENTIC_PORTAL_COOKIE_SECURE=0
Environment=AGENTIC_PORTAL_ALLOWED_HOSTS=179.198.117.31
Environment="GHOSTCLI_MODEL=claude-sonnet-5[1m]"
Environment="GHOSTCLI_ORCHESTRATOR_MODEL=claude-fable-5[1m]"

ExecStart=/opt/agentic-portal/venv/bin/python -m agentic.portal --host 0.0.0.0 --port 8767 --state /var/lib/agentic-portal/state.json --allow-remote --allow-insecure-http
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=20s
KillSignal=SIGTERM
KillMode=mixed

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateMounts=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/var/lib/agentic-portal/state.json
ReadWritePaths=/var/lib/agentic-portal/inbox.jsonl
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

RestrictAddressFamilies=AF_UNIX AF_INET
SocketBindDeny=any
SocketBindAllow=ipv4:tcp:8767

LimitCORE=0
LimitNOFILE=256
LimitNPROC=64
TasksMax=64
MemoryHigh=384M
MemoryMax=512M
OOMPolicy=stop

StandardOutput=journal
StandardError=journal
SyslogIdentifier=agentic-portal

[Install]
WantedBy=multi-user.target
