[Unit]
Description=Agentic improve developer (queue → Claude CLI via GhostCLI models)
Documentation=file:///Agentic/improve/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/Agentic
EnvironmentFile=-/root/.automaton/.env
EnvironmentFile=-/Agentic/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/Agentic/src
Environment=AGENTIC_LIVE_TRADE=0
Environment=ANTHROPIC_BASE_URL=https://ghostcli.dev
Nice=12
TimeoutStartSec=1800
ExecStart=/Agentic/.venv/bin/python -m agentic improve develop
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agentic-improve-dev

[Install]
WantedBy=multi-user.target
