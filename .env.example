# Copy to .env locally if needed. Canonical secrets stay in ~/.automaton/.
# GHOSTCLI_API_KEY=
# GHOSTCLI_BASE_URL=https://ghostcli.dev
AGENTIC_LIVE_TRADE=0
AGENTIC_INTERVAL_SECONDS=90
BYBIT_MODE=live
BYBIT_CATEGORY=spot
BYBIT_ENV_FILE=/root/.automaton/bybit-murre.env
# ARO — preencher só em /root/.automaton/aro.env (não neste repo).
# ARO_COMMERCIAL_OUTBOUND=0
# ARO_OWNER_NAME=
# ARO_BUSINESS_NAME=
# ARO_MINIMUM_PAYOUT=
# ARO_INITIAL_OPERATING_BUDGET=
# ARO_MAX_SINGLE_EXPENSE=
# ARO_MAX_DAILY_EXPENSE=
# ARO_MINIMUM_CASH_RESERVE=
# ARO_PRICE_FLOOR_BRL=250
# Destino de payout: ficheiro 0600 /root/.automaton/aro-payout.dest (o agente não cria nem edita).
# Correio ARO: /root/.automaton/aro-mail.env (AgentMail; nunca commitar a chave).
# ARO_MAIL_ADDRESS=agentic-aro@agentmail.to
