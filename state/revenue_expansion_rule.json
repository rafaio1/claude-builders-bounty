{
  "rule": "REVENUE_EXPANSION",
  "version": 1,
  "enforced_at": "2026-08-26T03:07:56.623246+00:00",
  "policy": "If current process has no actionable path to generate capital, do not close or repeat unproductive work. Document exhaustion criteria with evidence, preserve pending item tracking, and expand to adjacent lawful non-duplicate process.",
  "funnel": [
    "discover",
    "qualify",
    "zero_capital_pilot",
    "evidence",
    "controlled_scale",
    "collect",
    "reconcile"
  ],
  "pre_pilot_checks": [
    "primary_source_verification",
    "current_terms",
    "automation_permission",
    "eligibility",
    "kyc_country",
    "real_payout",
    "payment_history",
    "total_cost",
    "time_to_cash",
    "legal_operational_risk",
    "fraud_risk",
    "wise_bybit_binance_receivability"
  ],
  "priority_order": [
    "zero_capital_opportunities",
    "paid_contracts",
    "verifiable_bounties",
    "digital_products",
    "technical_services_with_identifiable_buyer"
  ],
  "rejections": [
    "promises",
    "pyramids",
    "wash_trading",
    "spam",
    "fraud",
    "manipulation",
    "platform_abuse",
    "symbolic_return_only"
  ],
  "target_usd": 20000000,
  "target_nature": "aspirational_per_process_never_guarantee",
  "capital_wise_constraints": {
    "allowed": [
      "research",
      "prepare_lawful_opportunities"
    ],
    "forbidden_autonomous": [
      "transfer",
      "invest",
      "buy",
      "sign",
      "accept_contract",
      "commit_balance"
    ],
    "principal_use_conditions": [
      "verifiable_contractual_regulatory_protection",
      "quantified_risk_with_max_loss",
      "liquidity_assessed",
      "fees_accounted",
      "counterparty_risk_assessed",
      "custody_verified",
      "adverse_scenario_modeled",
      "demonstrated_net_expectation",
      "explicit_human_approval_before_first_movement"
    ]
  },
  "prohibited_claims": [
    "marketing_hype",
    "backtest_as_guarantee",
    "apy_guarantee",
    "unaudited_third_party_guarantee",
    "past_performance_as_guarantee"
  ],
  "accounting_separation": [
    "initial_capital",
    "principal_at_risk",
    "realized_profit",
    "realized_loss",
    "pending_values",
    "potential_values"
  ],
  "telegram_gate": "realized_confirmed_capital_only"
