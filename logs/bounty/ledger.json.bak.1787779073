      "status": "closed_exhausted",
      "target": "Yahoo Finance / Yahoo News / Yahoo Mail APIs",
      "scope_verified": true,
      "policy_source": "https://legal.yahoo.com/xw/en/yahoo/coordinated-vulnerability-disclosure-program-policy/index.html",
      "intigriti_page": "https://app.intigriti.com/programs/yahoo/yahoobugbounty/detail",
      "bounty_table": {
        "low": "$100-500",
        "medium": "$500-3k",
        "high": "$3k-10k",
        "critical": "$10k-15k"
      },
      "in_scope_assets": [
        "*ensemble*.yahoo.com",
        "*omega*.yahoo.com",
        "apis.mail.yahoo.com",
        "data.mail.yahoo.com",
        "onepush.query.yahoo.com",
