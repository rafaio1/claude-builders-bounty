        "SSP Advertising Platforms",
        "TW eCommerce: Store",
        "Third-party hosted assets",
        "DoS",
        "Social engineering",
        "CSV injection without impact"
      ],
      "rules": {
        "own_accounts_only": true,
        "no_automated_scanners": true,
        "no_dos": true,
        "no_social_engineering": true,
        "safe_harbor": true,
        "pgp_required_for_email": true,
        "max_rate": "1 req/15s manual only"
      },
      "hypotheses": [
        "IDOR in apis.mail.yahoo.com or data.mail.yahoo.com via predictable resource IDs",
        "SSRF via URL preview/embed in Yahoo Mail or News rendering",
        "Cache poisoning on yimg.com CDN-served assets via unkeyed headers",
        "Auth bypass in Identity Services or Gemini endpoints",
        "XSS in Yahoo Sports Fantasy profiles or user-generated content"
      ],
      "next_action": "Select new Intigriti public program with verified scope and recent payouts. Prioritize programs with explicit API endpoints or client-side attack surface accessible without platform auth.",
      "notes": "Mysterio SSRF rejected (hash-signed). Batch v3 rejected (404). Telemetry traces rejected (404/HTML). Finance APIs rate-limited. Remaining viable: Fantasy Sports IDOR (auth-gated), yimg.com cache poisoning (untested). Exhaustion imminent.",
      "api_endpoints_discovered": {
        "finance_query_v7": "https://query1.finance.yahoo.com/v7/finance/quote (429 rate limited, crumb required)",
        "finance_chart_v8": "https://query2.finance.yahoo.com/v8/finance/chart/{symbol} (429 rate limited)",
        "finance_batch_v3": "/ws/v3/batch",
        "sports_telemetry": "/api/telemetry/v1/traces/",
        "mysterio_image_api": "https://s.yimg.com/lo/mysterio/api/{hash}/lightyear_networkapi/... (image processing proxy)",
        "fantasy_sports_subdomains": [
          "baseball.fantasysports.yahoo.com",
          "basketball.fantasysports.yahoo.com",
          "bestball.fantasysports.yahoo.com",
          "college.fantasysports.yahoo.com"
        ]
      },
      "rate_limit_observed": true,
      "rate_limit_note": "query1/query2 finance APIs return 429 after minimal requests; aggressive bot protection active",
      "hypotheses_refined": [
        "Mysterio image API: test for SSRF via manipulated source URLs in hash path or query params",
        "Fantasy Sports subdomains: IDOR in league/player/team endpoints using predictable numeric IDs",
        "Finance API crumb bypass: test if missing/invalid crumb leaks data or returns different error revealing internal state",
        "Batch endpoint /ws/v3/batch: test for parameter pollution or nested request injection",
        "Telemetry endpoint /api/telemetry/v1/traces/: test for log injection or PII leakage in trace payloads"
      ],
      "mysterio_ssrf_test": {
        "endpoint": "https://s.yimg.com/lo/mysterio/api/{hash}/lightyear_networkapi/.../{url}",
        "test_url": "http://127.0.0.1:8080/test",
        "result": "HTTP 401 Invalid Api",
        "interpretation": "Mysterio validates hash signature against source URL; tampered URL fails auth check before fetch. SSRF via URL substitution not viable without hash collision or signing bypass.",
        "conclusion": "REJECTED - hash-signed proxy prevents arbitrary URL injection"
      },
      "hypotheses_status": {
        "mysterio_ssrf": "rejected_hash_signed",
        "fantasy_idor": "pending_auth_required",
        "finance_crumb_bypass": "deprioritized_rate_limited",
        "batch_injection": "rejected_404_not_found",
        "telemetry_pii": "rejected_404_html_fallback",
        "yimg_cache_poisoning": "rejected_404_static_path"
      },
      "test_results": {
